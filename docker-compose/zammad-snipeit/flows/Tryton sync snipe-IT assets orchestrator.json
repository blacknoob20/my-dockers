        "name": "Wait models"
      },
      {
        "parameters": {
          "jsCode": "const categories = {};\nfor (const category of $input.first().json.modelos) {\n  categories[category.tryton_model_id] = category.snipe_category_id;\n}\n\nconst models = {}\nfor (const model of $input.first().json.modelos) {\n  models[model.tryton_model_id] = model.snipe_model_id;\n}\n\nconst statuses = {} \nfor (const status of $input.first().json.status) {\n  statuses[status.tryton_name] = status.snipe_status_id;\n}\nconst assets = $('Wait models').first().json.result;\nreturn assets.map(asset => {\n    return { \n      ...asset,\n      snipe_category_id: categories[asset.asset_model_id],\n      snipe_model_id: models[asset.asset_model_id],\n      snipe_status_id: statuses[asset.asset_state]\n    };\n});"
        },
