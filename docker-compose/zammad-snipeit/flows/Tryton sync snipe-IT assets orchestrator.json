          "query": "SELECT\n  (SELECT json_agg(json_build_object(\n  \t  'tryton_model_id', tryton_model_id,\n      'tryton_name',     tryton_name,\n      'snipe_model_id',  snipe_model_id,\n      'snipe_name',      snipe_name,\n      'snipe_category_id', snipe_category_id\n   ) ORDER BY tryton_name)\n   FROM tryton_snipe_model_map)  AS modelos,\n  (SELECT json_agg(json_build_object(\n      'tryton_name',     tryton_name,\n      'snipe_status_id', snipe_status_id,\n      'snipe_name',      snipe_name,\n      'status_type',     status_type\n   ) ORDER BY tryton_name)\n   FROM tryton_snipe_status_map) AS status;",
