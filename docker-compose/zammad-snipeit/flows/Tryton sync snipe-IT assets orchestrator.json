          "assignments": {
            "assignments": [
              {
                "id": "9f3f6a48-128b-4a1a-80b0-bcc5ed757715",
                "name": "result",
                "value": "={{\n  Object.values(\n    $('Flatten assets').first().json.result.reduce((acc, {name, asset_model_id, asset_model_name }) => {\n      const i = name.indexOf(':');\n      const category = (i >= 0 ? name.slice(0, i) : 'NO DEFINIDO')\n      .trim()\n      .toUpperCase();\n      acc[asset_model_id] = { asset_model_id, asset_model_name, category };\n      return acc;\n    }, {})\n  )\n}}",
                "type": "array"
              }
            ]
          },
          "options": {}
        },
