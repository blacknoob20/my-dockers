    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const staticData = $getWorkflowStaticData('global');\nconst MAX_RETRIES = 3;\n\nif (staticData.retryCount >= MAX_RETRIES) {\n  // Resetear para la próxima ejecución del schedule\n  staticData.retryCount = 0;\n  staticData.sessionHash = null;\n  // Limpiar la sesion de tryton\n  staticData.tryton = null;\n  return { \n    json: { \n      shouldStop: true, \n      reason: \"Max retries reached\" \n    } \n  };\n}\n\n// Incrementar contador\nstaticData.retryCount = (staticData.retryCount || 0) + 1;\n\nreturn { \n  json: { \n    shouldStop: false, \n    retryCount: staticData.retryCount \n  } \n};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1888,
        720
      ],
      "id": "a1e40fea-4788-4619-9b1d-5c1ef66a87d9",
