    {
      "parameters": {
        "jsCode": "const t = $('Extract Ticket').first().json;\nconst inp = $input.first().json;\nconst email = String(t.customer_email || '').toLowerCase();\nconst rows = inp.body?.rows || [];\nconst snipeError = !inp.body && !!inp.error;\nconst hits = email ? rows.filter(r => String(r.email || '').toLowerCase() === email) : [];\nhits.sort((a, b) => (a.id ?? 9e15) - (b.id ?? 9e15));\nconst best = hits[0];\nreturn [{ json: {\n  ticket_id: t.ticket_id,\n  ticket_number: t.ticket_number,\n  customer_email: t.customer_email,\n  snipe_user_id: best ? best.id : null,\n  snipe_error: snipeError,\n  match_count: hits.length,\n}}];"
      },
