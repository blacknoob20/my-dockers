    {
      "parameters": {
        "jsCode": "const t = $('Extract Ticket').first().json;\nconst m = $('Match Snipe User').first().json;\nconst inp = $input.first().json;\nconst rows = inp.body?.rows || [];\nconst err = !inp.body;\nconst count = rows.length;\nconst tags = rows.map(r => r.asset_tag).join(', ');\nconst summary = rows.map(r => {\n  const model = r.model?.name || 'Modelo?';\n  const status = r.status_label?.name || 'Estado?';\n  const serial = r.serial || 's/n';\n  return `- ${r.asset_tag} — ${model} (${status}) S/N ${serial}`;\n}).join('\\n');\nconst note = err\n  ? 'No se pudo consultar los activos en Snipe-IT (error de red/API).'\n  : (count > 0\n    ? `Activos asignados en Snipe-IT (${count}):\\n${summary}`\n    : 'Snipe-IT no reporta activos asignados a este usuario.');\nreturn [{ json: {\n  ticket_id: t.ticket_id,\n  ticket_number: t.ticket_number,\n  customer_email: t.customer_email,\n  snipe_user_id: m.snipe_user_id,\n  asset_count: count,\n  asset_tags: tags,\n  asset_summary: summary,\n  note_body: note,\n}}];"
      },
