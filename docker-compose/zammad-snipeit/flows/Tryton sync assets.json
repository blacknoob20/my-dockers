    {
      "parameters": {
        "jsCode": "const categories = {};\nfor (const category of $input.all()) {\n  categories[category.json.tryton_model_id] = category.json.snipe_category_id;\n}\n\nconst models = {}\nfor (const model of $input.all()) {\n  models[model.json.tryton_model_id] = model.json.snipe_model_id;\n}\n\nconst assets = $('Wait models').first().json.result;\nreturn assets.map(asset => {\n    return { \n      ...asset,\n      snipe_category_id: categories[asset.asset_model_id],\n      snipe_model_id: models[asset.asset_model_id]\n    };\n});"
      },
