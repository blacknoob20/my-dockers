    {
      "parameters": {
        "content": "# Docs de los nodos\n**Buscar activos TRYTON: (asset_type: Informatica)**\n\n`ID` · `Descripción`\n`06` · `141.01.07 Equipos y Sistemas Informáticos (Corriente)`\n`39` · `191.01.02 Licencias Computacionales (Corriente)`\n`40` · `191.01.03 Sistemas de Información (Corriente)`\n`48` · `634.45.07 Equipos, Sistemas y Paquetes Informáticos`\n`61` · `151.45.07 Equipos, Sistemas y Paquetes Informáticos (no Depreciables)`\n`92` · `151.41.07 Equipos, Sistemas y Paquetes Informáticos`\n\n**Registrar Categorias SNIPE-IT: (http://<snipe-host>/api/v1/categories)**",
        "height": 384,
        "width": 672
      },
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -1312,
        -352
      ],
      "id": "bded5975-5ecf-46be-b953-04072875d58e",
      "name": "Sticky Note"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://192.168.56.102:8000/dbegoblocal/",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "={{ $json.authorization }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "{\n  \"id\": 0,\n  \"method\": \"model.asset.search_read\",\n  \"params\": [\n    [\n      [\"asset_type_new\", \"in\", [6, 39, 40, 48, 61, 92]]\n    ],\n    0, 100, null,\n    [\n      \"id\",\n      \"code\",\n      \"internal_code\", \n      \"name\", \n      \"asset_state\", \n      \"asset_type_new.rec_name\",\n      \"actual_value\", \n      \"category.rec_name\", \n      \"company.rec_name\",\n      \"current_owner.rec_name\", \n      \"asset_model.rec_name\"\n    ],\n    {}\n  ]\n}",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [
        -912,
        64
      ],
      "id": "5bfe5e46-61dc-40c9-8f22-40b9f5b9266f",
      "name": "Search assets"
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "85fc163a-f19b-4457-81d0-6c1393265ca7",
              "name": "result",
              "value": "={{ \n  $json.result.map(r => ({ \n      id: r.id, \n      name: r.name,\n      asset_state: r.asset_state,\n      code: r.code,\n      internal_code: r.internal_code,\n      actual_value: r.actual_value.decimal,\n      asset_model_id: r['asset_model.'].id,\n      asset_model_name: r['asset_model.'].rec_name,\n      current_owner_id: r['current_owner.']?.id,\n      current_owner_name: r['current_owner.']?.rec_name,\n      category: (r.name.includes(':') ? r.name.split(':')[0] : 'NO DEFINIDO'),\n      category_id: r['category.']?.id,\n      category_name: r['category.']?.rec_name,\n    })\n  ) \n}}",
              "type": "array"
            }
          ]
        },
        "options": {}
      },
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
