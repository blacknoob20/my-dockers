        "name": "Is SnipeIT Saved?"
      },
      {
        "parameters": {
          "jsCode": "const status   = $('Executed by Tryton sync assets').first().json.status;\nconst trytonStatuses = $input.first().json.statuses;\n\n// Tipos conocidos\nconst knownTypes = {\n  good:        { type: \"deployable\" },\n  regular:     { type: \"deployable\" },\n  bad:         { type: \"pending\"    },\n  seized:      { type: \"pending\"    },\n  repair:      { type: \"pending\"    },\n  disuse:      { type: \"pending\"    },\n  unspecified: { type: \"pending\"    },\n  baja:        { type: \"archived\"   },\n};\n\n// ── ¿Está en el catálogo de Tryton? ──\nconst catalogEntry = trytonStatuses.find(({ name }) => name === status);\nif (!catalogEntry) throw new Error(`Estado \"${status}\" no existe en el catálogo de Tryton`);\n\n// ── ¿Tenemos mapeo conocido? ──\nconst mapping = knownTypes[status];\nif (mapping) return [{ json: { \n  status,\n  ...mapping,\n  label: catalogEntry.label,\n  desired_name: `${status}: ${catalogEntry.label}`,\n  unknown: false\n} }];\n\n// ── Estado nuevo sin mapear — label por defecto para identificarlo ──\nreturn [{ json: {\n  status,\n  label: `Sin mapear: ${status}`,\n  type: \"pending\",\n  unknown: true\n}}];"
        },
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "position": [
          -736,
