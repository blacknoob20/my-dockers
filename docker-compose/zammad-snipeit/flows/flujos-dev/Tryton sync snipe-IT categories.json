    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const t = ($('Tryton sync snipe-IT assets orchestrator').item.json.category || '').trim().toUpperCase();\nconst rows = ($json.body && $json.body.rows) || [];\nconst m = rows.find(r => (r.name || '').trim().toUpperCase() === t);\nif (m) {\n  const now = new Date().toISOString();\n  return { json: { found: true, body: { payload: { id: m.id, name: $('Tryton sync snipe-IT assets orchestrator').item.json.category, created_at: now, updated_at: now } } } };\n}\nreturn { json: { found: false } };"
      },
