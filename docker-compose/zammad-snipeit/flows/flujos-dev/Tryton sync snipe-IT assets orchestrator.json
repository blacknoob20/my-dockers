              "name": "category",
              "type": "array",
              "value": "={{\n[...new Set(\n  $json.result.map(r => {\n    const i = r.name.indexOf(':');\n    return (i >= 0 ? r.name.slice(0, i) : 'NO DEFINIDO')\n      .trim()\n      .toUpperCase();\n  })\n)]\n}}"
            }
          ]
        },
        "options": {}
