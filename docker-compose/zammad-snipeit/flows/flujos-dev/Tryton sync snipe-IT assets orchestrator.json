    {
      "parameters": {
        "content": "# Docs de los nodos\n**Buscar activos TRYTON: (asset_type: Informatica)**\n\n`ID` · `Descripción`\n`06` · `141.01.07 Equipos y Sistemas Informáticos (Corriente)`\n`39` · `191.01.02 Licencias Computacionales (Corriente)`\n`40` · `191.01.03 Sistemas de Información (Corriente)`\n`48` · `634.45.07 Equipos, Sistemas y Paquetes Informáticos`\n`61` · `151.45.07 Equipos, Sistemas y Paquetes Informáticos (no Depreciables)`\n`92` · `151.41.07 Equipos, Sistemas y Paquetes Informáticos`\n",
        "height": 304,
        "width": 768,
        "color": "#105612"
      },
      "id": "8694852e-106a-4528-9d6f-b73585f78275",
      "name": "Sticky Note",
