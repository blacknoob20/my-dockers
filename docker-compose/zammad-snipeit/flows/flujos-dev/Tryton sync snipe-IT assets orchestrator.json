    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.TRYTON_URL }}/{{ $env.TRYTON_DB }}/",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "={{ $json.authorization }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ \"id\": 0, \"method\": \"model.asset.search_read\", \"params\": [ ((since) => (since && $env.TRYTON_FULL_SYNC !== \"true\") ? [[\"asset_type_new\", \"in\", [6, 39, 40, 48, 61, 92]], [\"OR\", [\"write_date\", \">=\", since], [\"create_date\", \">=\", since]]] : [[\"asset_type_new\", \"in\", [6, 39, 40, 48, 61, 92]]])($('Get last sync').first().json.since), 0, null, null, [\"id\", \"code\", \"internal_code\", \"name\", \"asset_state\", \"asset_type_new.rec_name\", \"actual_value\", \"category.rec_name\", \"company.rec_name\", \"current_owner.rec_name\", \"asset_model.rec_name\"], {} ] }) }}",
        "options": {
          "timeout": 120000
        }
      },
      "id": "8f730304-c953-4ddf-a15b-6da9139a3701",
      "name": "Search assets",
      "type": "n8n-nodes-base.httpRequest",
      "position": [
        528,
        368
      ],
      "typeVersion": 4.4
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "85fc163a-f19b-4457-81d0-6c1393265ca7",
              "name": "result",
              "type": "array",
              "value": "={{ \n  $json.result.map(r => {\n    const model = r['asset_model.'];\n    const noModel = !model || model.rec_name === 'SIN MODELO';\n    \n    return {\n      id: r.id,\n      name: r.name,\n      asset_state: r.asset_state,\n      code: r.code,\n      internal_code: r.internal_code,\n      actual_value: r.actual_value.decimal,\n      asset_model_id: noModel ? 11 : model.id,\n      asset_model_name: noModel ? 'SIN MODELO' : model.rec_name,\n      current_owner_id: r['current_owner.']?.id,\n      current_owner_name: r['current_owner.']?.rec_name,\n      category: (r.name.includes(':') ? r.name.split(':')[0] : 'NO DEFINIDO'),\n      category_id: r['category.']?.id,\n      category_name: r['category.']?.rec_name,\n    };\n  }) \n}}"
            }
          ]
        },
        "options": {}
      },
      "id": "4865b9f1-4ac2-4e6c-b333-4016a2c26dc1",
      "name": "Flatten assets",
