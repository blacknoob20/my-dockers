        "query": "INSERT INTO integration_sync_log (execution_id, workflow_name, source_system, entity, entity_id, tryton_id, snipe_id, operation, request_payload, response_status, response_body, error_message, retry_count)\nVALUES ($1,$2,'tryton','asset',0,$3,0,$4,'',$5,$6,$7,0);",
        "options": {
