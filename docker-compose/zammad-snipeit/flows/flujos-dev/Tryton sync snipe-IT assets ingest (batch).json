    {
      "parameters": {
        "operation": "executeQuery",
        "query": "WITH ins AS (\n  INSERT INTO staging_tryton_assets (tryton_asset_id, code, internal_code, name, asset_state, tryton_model_id, tryton_model_name, category_name)\n  SELECT DISTINCT ON (x.tryton_asset_id) x.tryton_asset_id, x.code, x.internal_code, x.name, x.asset_state, x.tryton_model_id, x.tryton_model_name, x.category_name\n  FROM jsonb_to_recordset($1::jsonb) AS x(tryton_asset_id int, code text, internal_code text, name text, asset_state text, tryton_model_id int, tryton_model_name text, category_name text)\n  ON CONFLICT (tryton_asset_id) DO NOTHING\n  RETURNING 1\n) SELECT COUNT(*)::int AS staged FROM ins;",
        "options": {
          "queryReplacement": "={{ [ $('Tryton sync snipe-IT assets orchestrator').first().json.payload ] }}"
        }
      },
      "id": "ef529ee4-fbf3-4b2a-9473-a90663eeb024",
      "name": "Load staging (bulk)",
      "type": "n8n-nodes-base.postgres",
