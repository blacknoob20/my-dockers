        "jsCode": "const batch = ($('Batch changes').item && $('Batch changes').item.json) ? $('Batch changes').item.json : {};\nconst trytonId = batch.id;\nconst operation = batch.action || 'create';\nconst targetTag = (batch.code || '').trim();\nconst rows = ($json.body && $json.body.rows) || [];\nconst m = rows.find(r => (r.asset_tag || '').trim() === targetTag && !r.deleted_at);\nif (m) {\n  return { json: { found: true, tryton_id: trytonId, operation, body: { status: 'success', payload: { id: m.id, asset_tag: m.asset_tag, name: m.name } } } };\n}\nconst response = $json;\nlet statusCode = response.statusCode || null;\nlet errorMsg = response.error?.message || response.body?.message || null;\nlet responseBody = null;\ntry { responseBody = JSON.stringify(response.body || response); } catch(e) { responseBody = String(response); }\nlet orig = null;\ntry {\n  const c = $('Create snipe-IT asset (batch)').item;\n  if (c && (c.json.statusCode || c.json.body || c.json.error)) { orig = c.json; }\n} catch(e) {}\nif (!orig) {\n  try {\n    const u = $('Update snipe-IT asset (batch)').item;\n    if (u && (u.json.statusCode || u.json.body || u.json.error)) { orig = u.json; }\n  } catch(e) {}\n}\nif (orig) {\n  statusCode = orig.statusCode || statusCode;\n  const origMsg = orig.body?.messages || orig.body?.message || orig.error?.message || orig.message;\n  if (origMsg) errorMsg = origMsg;\n  try { responseBody = JSON.stringify(orig.body || orig); } catch(e) {}\n  if (errorMsg && typeof errorMsg === 'object') errorMsg = JSON.stringify(errorMsg);\n}\nif (errorMsg && typeof errorMsg === 'object') errorMsg = JSON.stringify(errorMsg);\nlet requestPayload = null;\ntry { requestPayload = JSON.stringify({ asset_tag: batch.code, name: batch.name }); } catch(e) {}\nreturn { json: { found: false, tryton_id: trytonId, operation, response_status: statusCode != null ? String(statusCode) : null, error_message: errorMsg ? String(errorMsg).slice(0,500) : null, response_body: responseBody ? String(responseBody).slice(0,2000) : null, request_payload: requestPayload } };"
