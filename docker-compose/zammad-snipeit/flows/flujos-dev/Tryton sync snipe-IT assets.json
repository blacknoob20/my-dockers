    {
      "id": "614c0f96-ab3c-4d67-bef9-5209eb6d8da7",
      "name": "Run summary",
      "type": "n8n-nodes-base.postgres",
      "position": [
        2704,
        208
      ],
      "parameters": {
        "query": "INSERT INTO sync_run_summary (run_id, total_tryton, to_create, to_update, unchanged, missing_model, deleted_in_tryton, api_errors, finished_at)\nSELECT $1, s.total, $2::int, $3::int,\n       GREATEST(s.total - $2::int - $3::int - mm.cnt, 0), mm.cnt, (CASE WHEN $4::boolean THEN del.cnt ELSE 0 END),\n       (SELECT COUNT(*)::int FROM integration_sync_log WHERE execution_id = $1), now()\nFROM (SELECT COUNT(*)::int AS total FROM staging_tryton_assets) s,\n     (SELECT COUNT(*)::int AS cnt FROM staging_tryton_assets st\n        LEFT JOIN tryton_snipe_model_map m ON m.tryton_model_id = st.tryton_model_id AND m.snipe_model_id IS NOT NULL\n        LEFT JOIN tryton_snipe_status_map ss ON ss.tryton_name = st.asset_state\n       WHERE m.tryton_model_id IS NULL OR ss.tryton_name IS NULL) mm,\n     (SELECT COUNT(*)::int AS cnt FROM tryton_snipe_asset_map am\n        LEFT JOIN staging_tryton_assets st ON st.tryton_asset_id = am.tryton_asset_id\n       WHERE st.tryton_asset_id IS NULL) del\nRETURNING *;",
        "options": {
          "queryReplacement": "={{ [ String($execution.id), $('Diff assets (batch)').all().filter(i => i.json.action === 'create').length, $('Diff assets (batch)').all().filter(i => i.json.action === 'update').length , ($('Tryton sync snipe-IT assets orchestrator').first().json.is_full !== false) ] }}"
        },
        "operation": "executeQuery"
      },
      "credentials": {
        "postgres": {
          "id": "vJtGvptYH9m03zLH",
          "name": "Postgres n8n account"
        }
