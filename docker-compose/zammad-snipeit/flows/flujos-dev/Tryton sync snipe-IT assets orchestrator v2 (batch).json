    {
      "parameters": {
        "jsCode": "const assets = $('Flatten assets').first().json.result;\nconst rows = assets.map(a => ({\n  tryton_asset_id: a.id,\n  code: a.code ?? null,\n  internal_code: a.internal_code ?? null,\n  name: a.name ?? null,\n  asset_state: a.asset_state ?? null,\n  tryton_model_id: a.asset_model_id ?? null,\n  tryton_model_name: a.asset_model_name ?? null,\n  category_name: a.category ?? null\n}));\nreturn [{ json: { payload: JSON.stringify(rows), total: rows.length } }];"
      },
