        }
      }
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "WITH ins AS (\n  INSERT INTO staging_tryton_assets (tryton_asset_id, code, internal_code, name, asset_state, tryton_model_id, tryton_model_name, category_name)\n  SELECT DISTINCT ON (x.tryton_asset_id) x.tryton_asset_id, x.code, x.internal_code, x.name, x.asset_state, x.tryton_model_id, x.tryton_model_name, x.category_name\n  FROM jsonb_to_recordset($1::jsonb) AS x(tryton_asset_id int, code text, internal_code text, name text, asset_state text, tryton_model_id int, tryton_model_name text, category_name text)\n  ON CONFLICT (tryton_asset_id) DO NOTHING\n  RETURNING 1\n) SELECT COUNT(*)::int AS staged FROM ins;",
        "options": {
          "queryReplacement": "={{ [ $('Prepare staging payload').first().json.payload ] }}"
        }
      },
      "id": "ef529ee4-fbf3-4b2a-9473-a90663eeb024",
      "name": "Load staging (bulk)",
      "type": "n8n-nodes-base.postgres",
      "position": [
        2176,
        368
      ],
      "typeVersion": 2.6,
      "alwaysOutputData": true,
      "credentials": {
        "postgres": {
          "id": "qJJfZl7PuKahcYb0",
          "name": "Postgres account"
        }
      }
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT s.tryton_asset_id AS id, s.code, s.internal_code, s.name, s.asset_state,\n       s.tryton_model_id, m.snipe_model_id, st.snipe_status_id, am.snipe_asset_id,\n       CASE WHEN am.tryton_asset_id IS NULL THEN 'create' ELSE 'update' END AS action\nFROM staging_tryton_assets s\nJOIN tryton_snipe_model_map m  ON m.tryton_model_id = s.tryton_model_id AND m.snipe_model_id IS NOT NULL\nJOIN tryton_snipe_status_map st ON st.tryton_name = s.asset_state\nLEFT JOIN tryton_snipe_asset_map am ON am.tryton_asset_id = s.tryton_asset_id\nWHERE am.tryton_asset_id IS NULL\n   OR am.snipe_asset_tag      IS DISTINCT FROM s.code\n   OR am.tryton_name          IS DISTINCT FROM s.name\n   OR am.snipe_model_id       IS DISTINCT FROM m.snipe_model_id\n   OR am.snipe_status_id      IS DISTINCT FROM st.snipe_status_id\n   OR am.tryton_internal_code IS DISTINCT FROM s.internal_code\nORDER BY s.tryton_asset_id;",
        "options": {}
      },
