        4784,
        1648
      ],
      "typeVersion": 1
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.TRYTON_URL }}/{{ $env.TRYTON_DB }}/",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "={{ $json.authorization }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "{\n  \"id\": 0,\n  \"method\": \"model.asset.search_read\",\n  \"params\": [\n    [\n      [\"asset_type_new\", \"in\", [6, 39, 40, 48, 61, 92]]\n    ],\n    0, null, null,\n    [\n      \"id\",\n      \"code\",\n      \"internal_code\", \n      \"name\", \n      \"asset_state\", \n      \"asset_type_new.rec_name\",\n      \"actual_value\", \n      \"category.rec_name\", \n      \"company.rec_name\",\n      \"current_owner.rec_name\", \n      \"asset_model.rec_name\"\n    ],\n    {}\n  ]\n}",
        "options": {}
      },
      "id": "0ed65c05-5444-4fca-beeb-8ed4990b4cc7",
      "name": "Search assets",
      "type": "n8n-nodes-base.httpRequest",
      "position": [
        5168,
        1984
      ],
      "typeVersion": 4.4
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "85fc163a-f19b-4457-81d0-6c1393265ca7",
              "name": "result",
              "type": "array",
              "value": "={{ \n  $json.result.map(r => {\n    const model = r['asset_model.'];\n    const noModel = !model || model.rec_name === 'SIN MODELO';\n    \n    return {\n      id: r.id,\n      name: r.name,\n      asset_state: r.asset_state,\n      code: r.code,\n      internal_code: r.internal_code,\n      actual_value: r.actual_value.decimal,\n      asset_model_id: noModel ? 11 : model.id,\n      asset_model_name: noModel ? 'SIN MODELO' : model.rec_name,\n      current_owner_id: r['current_owner.']?.id,\n      current_owner_name: r['current_owner.']?.rec_name,\n      category: (r.name.includes(':') ? r.name.split(':')[0] : 'NO DEFINIDO'),\n      category_id: r['category.']?.id,\n      category_name: r['category.']?.rec_name,\n    };\n  }) \n}}"
            }
          ]
        },
        "options": {}
      },
      "id": "fb7223c2-32f5-48ee-8181-973f8ec27f96",
      "name": "Flatten assets",
      "type": "n8n-nodes-base.set",
      "position": [
        5328,
        1984
      ],
      "typeVersion": 3.4
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "2af9f5ec-afc2-4200-8f63-fbb041daa3b2",
              "name": "category",
              "type": "array",
              "value": "={{\n[...new Set(\n  $json.result.map(r => {\n    const i = r.name.indexOf(':');\n    return (i >= 0 ? r.name.slice(0, i) : 'NO DEFINIDO')\n      .trim()\n      .toUpperCase();\n  })\n)]\n}}"
            }
          ]
        },
        "options": {}
      },
      "id": "4f9e2cb4-a54f-403a-8a0c-7aa4d92875e3",
