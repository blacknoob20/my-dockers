    {
      "parameters": {
        "operation": "executeQuery",
        "query": "insert into public.tryton_snipe_model_map\n  (tryton_model_id, tryton_name, snipe_model_id, snipe_category_id, snipe_name, created_at, updated_at)\nselect s.tryton_model_id, s.tryton_name, s.snipe_model_id, s.snipe_category_id, s.snipe_name,\n       s.created_at, s.updated_at\nfrom jsonb_to_recordset($1::jsonb) as s(\n  tryton_model_id int, tryton_name text, snipe_model_id int, snipe_category_id int,\n  snipe_name text, created_at timestamptz, updated_at timestamptz)\non conflict (tryton_model_id) do update set\n  tryton_name = excluded.tryton_name,\n  snipe_model_id = excluded.snipe_model_id,\n  snipe_category_id = excluded.snipe_category_id,\n  snipe_name = excluded.snipe_name,\n  updated_at = excluded.updated_at",
