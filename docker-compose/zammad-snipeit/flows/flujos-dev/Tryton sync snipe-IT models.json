    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const t = ($('Prepare items').item.json.asset_model_name || '').trim().toUpperCase();\nconst rows = ($json.body && $json.body.rows) || [];\nconst m = rows.find(r => (r.name || '').trim().toUpperCase() === t);\nif (m) {\n  const now = new Date().toISOString();\n  const catId = (m.category && m.category.id) || null;\n  return { json: { found: true, body: { payload: { id: m.id, name: m.name, category: { id: catId }, created_at: { datetime: now }, updated_at: { datetime: now } } } } };\n}\nconst response = $json;\nconst errorMsg = response.error?.message || response.body?.messages || response.body?.message || response.message || null;\nconst statusCode = response.statusCode || response.error?.status || null;\nlet operation = 'Unknown';\ntry { if ($('Create snipe-it model').item?.json?.statusCode || $('Create snipe-it model').item?.json?.error) operation = 'Create'; } catch(e) {}\nif (operation === 'Unknown') {\n  try { if ($('Update snipe-it model').item?.json?.statusCode || $('Update snipe-it model').item?.json?.error) operation = 'Update'; } catch(e) {}\n}\nlet requestPayload = null;\ntry { requestPayload = JSON.stringify({ name: $('Prepare items').item.json.asset_model_name }); } catch(e) {}\nreturn { json: { found: false, response_status: statusCode, error_message: errorMsg, response_body: JSON.stringify(response), operation, request_payload: requestPayload } };"
      },
