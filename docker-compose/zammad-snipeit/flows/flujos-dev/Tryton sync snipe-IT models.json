    {
      "parameters": {
        "jsCode": "const rows = $json.models || [];\nconst out = [];\nfor (const m of rows) {\n  let action = null;\n  if (m.snipe_model_id === undefined || m.snipe_model_id === null) action = 'create';\n  else if ((m.map_tryton_name ?? '') !== (m.asset_model_name ?? '')) action = 'update';\n  if (action) out.push({ json: { ...m, action }, pairedItem: { item: 0 } });\n}\nif (out.length) return out;\nreturn [{ json: { action: 'noop', total: rows.length, pending: 0, skipped: rows.length }, pairedItem: { item: 0 } }];"
      },
