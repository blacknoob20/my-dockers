    {
      "parameters": {
        "operation": "executeQuery",
        "query": "select coalesce(jsonb_agg(jsonb_build_object(\n  'asset_model_id', m.asset_model_id,\n  'asset_model_name', m.asset_model_name,\n  'category', m.category,\n  'snipe_model_id', mp.snipe_model_id,\n  'map_tryton_name', mp.tryton_name,\n  'snipe_category_id', coalesce(c.snipe_category_id, mp.snipe_category_id)\n)), '[]'::jsonb) as models\nfrom jsonb_to_recordset($1::jsonb) as m(\n    asset_model_id int, asset_model_name text, category text)\nleft join public.tryton_snipe_model_map mp on mp.tryton_model_id = m.asset_model_id\nleft join public.tryton_snipe_category_map c on c.tryton_name = m.category",
        "options": {
          "queryReplacement": "={{ [JSON.stringify($('Tryton sync snipe-IT assets orchestrator').first().json.result)] }}"
        }
