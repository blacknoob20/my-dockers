        "jsCode": "const s = $('Status asset').item.json;\nconst t = (s.status + ': ' + s.label).trim().toUpperCase();\nconst rows = ($json.body && $json.body.rows) || [];\nconst m = rows.find(r => (r.name || '').trim().toUpperCase() === t);\nif (m) {\n  const now = new Date().toISOString();\n  return { json: { found: true, body: { payload: { id: m.id, name: m.name, created_at: now, updated_at: now } } } };\n}\n\nconst response = $json;\nconst errorMsg = response.error?.message || response.body?.messages || null;\nconst statusCode = response.statusCode || response.error?.status || null;\n\nlet operation = 'Unknown';\ntry { if ($('Create snipe-it status').item?.json?.statusCode || $('Create snipe-it status').item?.json?.error) operation = 'Create'; } catch(e) {}\nif (operation === 'Unknown') {\n  try { if ($('Update snipe-it status').item?.json?.statusCode || $('Update snipe-it status').item?.json?.error) operation = 'Update'; } catch(e) {}\n}\n\nlet requestPayload = null;\ntry { requestPayload = JSON.stringify({name: s.desired_name}); } catch(e) {}\n\nreturn { json: {\n  found: false,\n  response_status: statusCode,\n  error_message: errorMsg,\n  response_body: JSON.stringify(response),\n  operation,\n  request_payload: requestPayload\n}};"
