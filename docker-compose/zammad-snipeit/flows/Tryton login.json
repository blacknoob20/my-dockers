        "jsCode": "const [uid,session] = $json.result;\nconst auth = Buffer\n  .from(`svc_n8n:${uid}:${session}`)\n  .toString('base64');\n\n// Guardar la sesion\nconst staticData = $getWorkflowStaticData('global');\n\nstaticData.tryton = {\n  uid,\n  session,\n  authorization: `Session ${auth}`\n};\nreturn staticData.tryton;"
      },
