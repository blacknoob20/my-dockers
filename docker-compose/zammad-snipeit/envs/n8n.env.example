# N8N Configuration
# N8N_RUNNERS_ENABLED=true       # Descomentar en producción (requiere n8n-runner)
# N8N_RUNNERS_MODE=external       # Descomentar en producción (requiere n8n-runner)
# N8N_RUNNERS_AUTH_TOKEN=...      # Descomentar en producción (requiere n8n-runner)
N8N_RUNNERS_MAX_OLD_SPACE_SIZE=4096
N8N_RUNNERS_TASK_TIMEOUT=3600
N8N_BLOCK_ENV_ACCESS_IN_NODE=false
EXECUTIONS_DATA_PRUNE=true
EXECUTIONS_DATA_MAX_AGE=168
EXECUTIONS_DATA_MAX_COUNT=500
EXECUTIONS_DATA_PRUNE_HARD_DELETE_INTERVAL=15
EXECUTIONS_DATA_PRUNE_INTERVAL=60
DB_POSTGRESDB_POOL_SIZE=5

# General Configuration
NODE_ENV=development
GENERIC_TIMEZONE=America/Guayaquil
TZ=America/Guayaquil

# Database Configuration
DB_TYPE=postgresdb
DB_POSTGRESDB_HOST=postgres
DB_POSTGRESDB_PORT=5432
DB_POSTGRESDB_DATABASE=n8n
DB_POSTGRESDB_USER=n8n_user
DB_POSTGRESDB_PASSWORD=your_n8n_password_here

# Tryton Environment Variables
TRYTON_URL=http://192.168.56.102:8000
TRYTON_DB=dbegoblocal
TRYTON_USER=svc_n8n
TRYTON_PASS=your_tryton_password_here
# Barrido completo (true) vs incremental por write_date/create_date >= Get last sync (false).
# Recrea n8n tras cambiarlo (env_file solo se lee al crear el contenedor).
TRYTON_FULL_SYNC=false

# Tryton DB Configuration
TRYTON_DB_HOST=tryton-db-host
TRYTON_DB_PORT=5432
TRYTON_DB_NAME=dbegoblocal
TRYTON_DB_USER=tryton_user
TRYTON_DB_PASSWORD=your_trytondb_password_here

# Mail Notification Configuration
MAIL_FROM=notificaciones@ejemplo.local
MAIL_FROM_NAME=Notificaciones Lab
MAIL_TO=usuario@ejemplo.local
MAIL_TO_NAME=Usuario Lab
MAIL_BODY=Error
MAIL_TOKEN=your_mail_token_here

# Snipe-IT configuration
SNIPE_HOST=http://snipe-it:80
SNIPEIT_TOKEN=your_snipeit_token_here
